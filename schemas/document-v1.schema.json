                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "block"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "updateBlock"
            },
            "blockId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
