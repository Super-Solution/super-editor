              "const": "setFormat"
            },
            "format": {
              "$ref": "#/$defs/format"
            }
          },
          "required": [
            "type",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "addCitation"
            },
            "citation": {
              "$ref": "#/$defs/citation"
