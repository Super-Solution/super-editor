        {
          "type": "object",
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "runs": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 100000
                  },
                  "bold": {
                    "type": "boolean"
                  },
                  "italic": {
                    "type": "boolean"
                  },
                  "code": {
                    "type": "boolean"
                  },
                  "href": {
                    "type": "string",
                    "maxLength": 4096,
