          },
          "required": [
            "type",
            "blocks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "duplicateBlock"
            },
            "blockId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "newIds": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 500,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "description": "Maps the block and every descendant (old id to new id)."
            },
            "afterId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "blockId",
            "expectedVersion",
            "newIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "replaceText"
