            "blockId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "find": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "replace": {
              "type": "string",
              "maxLength": 100000
            },
            "all": {
              "type": "boolean"
            },
            "caseSensitive": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "blockId",
            "expectedVersion",
            "find",
            "replace"
          ],
          "additionalProperties": false
