{
  "name": "super-editor-workspace",
  "version": "0.3.0-next.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/package-build.mjs",
    "test": "tsx --conditions=development --test tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "check": "npm run build && npm test",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "cli": "tsx --conditions=development packages/cli/src/cli.ts",
    "example": "tsx --conditions=development examples/headless.ts",
    "release:check": "node scripts/verify-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:repair-tags": "node scripts/repair-prerelease-tags.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
